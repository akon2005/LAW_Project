# ---- Secrets ----
.env
.env.local
.env.*.local
# Keep the templates, never the real files.
!.env.example
!backend/.env.example
!frontend/.env.example

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- Node / Frontend ----
node_modules/
dist/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---- Backend build/data artifacts ----
backend/data/.embed_cache.json
backend/data/processed/
backend/data/chromadb/
backend/data/db/
backend/data/doj_dataset.json
backend/errors.log
*.log
*.sqlite3
*.db
!backend/data/metadata.db
!backend/data/chroma_store/**
# The production vector store is committed on purpose (see docs/deployment.md):
# it carries the 9,375 indexed legal chunks from dedol-hf/india-case-legal-rag,
# so no host has to re-embed the corpus just to deploy code.
!backend/chroma_db/**

# ---- Generated runtime ingestion state ----
backend/data/checkpoints/
backend/data/ingestion_status.json

# ---- Scratch / generated reports ----
final.json

# ---- Datasets / large data ----
indian-supreme-court-judgments/

# ---- OS / Editor ----
.DS_Store
Thumbs.db
.idea/
.vscode/
.claude/
.cursor/
