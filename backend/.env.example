# ──────────────────────────────────────────────────────────────────────
# VIDHIVEDA backend configuration
# Copy to `.env` and fill in real values. Never commit a real .env.
# ──────────────────────────────────────────────────────────────────────

# ── LLM provider ──────────────────────────────────────────────────────
# "huggingface" | "openai" | "anthropic"
# Without a valid key the pipeline still runs: retrieval is live and the API
# returns sources with a warning instead of a generated summary.
LLM_PROVIDER=huggingface

# Hugging Face Inference API (LLM generation)
HF_API_TOKEN=hf-your-token-here
HF_BASE_URL=https://router.huggingface.co/v1
HF_MODEL=meta-llama/Llama-3.1-8B-Instruct

# OpenAI (optional)
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o-mini

# Anthropic (optional)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

LLM_TIMEOUT_SECONDS=45

# ── Dataset (Step 1) ──────────────────────────────────────────────────
# Registered in app/services/dataset_service.py:DATASET_REGISTRY
DATASET_NAME=india-case-legal-rag
# Development/testing cap. 9375 = the full dedol-hf/india-case-legal-rag split.
MAX_RECORDS=9375
# Chunks shorter than this are treated as invalid.
MIN_TEXT_LENGTH=20

# ── Embeddings (Step 4) ───────────────────────────────────────────────
# Swap for a legal-domain model (InLegalBERT / Legal-BERT) without code changes.
# NOTE: changing the model changes vector dimensions — re-ingest afterwards.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=32

# ── Vector store (Step 5) ─────────────────────────────────────────────
VECTOR_STORE_DIR=chroma_db
CASE_LAW_COLLECTION=vidhiveda_legal_cases
STATUTE_COLLECTION=vidhiveda_statutes
# Legacy collection used by the deprecated /api/search endpoint.
CHROMA_COLLECTION=lexrag_documents

# ── Retrieval (Steps 7, 8, 11) ────────────────────────────────────────
TOP_K=5
# Below this best-similarity score the API returns status="low_confidence"
# instead of forcing the model to answer.
LOW_CONFIDENCE_THRESHOLD=0.30
# Dense-only by default. Set to true for dense + BM25 (+ cross-encoder when available).
USE_RERANKER=false
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
RERANK_CANDIDATES=25

# ── Chunking (future datasets) ────────────────────────────────────────
CHUNK_SIZE=800
CHUNK_OVERLAP=200

# ── Server ────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
# "*" allows any origin (credentials are disabled in that case).
CORS_ORIGINS=*

# ── Dataset field mapping (Step 4) ────────────────────────────────────
# Leave blank to auto-detect from the dataset schema (scripts/inspect_dataset.py).
# Set only when a dataset's columns differ from the registry defaults.
TEXT_FIELD=
CASE_ID_FIELD=
CASE_NAME_FIELD=
COURT_FIELD=
DATE_FIELD=
YEAR_FIELD=
OUTCOME_FIELD=
SECTION_FIELD=
SOURCE_URL_FIELD=
# Optional explicit IPC<->BNS equivalence map (JSON). Empty = none assumed.
SECTION_EQUIVALENCE_MAP=

# ── Chunking (Step 8, document-level datasets only) ───────────────────
# "legal_aware" (paragraph/section boundaries) or "fixed".
CHUNK_STRATEGY=legal_aware

# ── Reranking (Step 13) ───────────────────────────────────────────────
RERANK_TOP_K=10

# ── Outcome prediction (Steps 16-21) ──────────────────────────────────
# Below this calibrated confidence a prediction is flagged low_confidence.
MIN_PREDICTION_CONFIDENCE=0.60
# Minimum retrieval score before evidence is treated as sufficient.
MIN_EVIDENCE_SCORE=0.30
OUTCOME_MODEL_DIR=data/models/outcome
# Optional custom {class: [synonyms]} outcome-label mapping (JSON).
OUTCOME_LABEL_MAP=
OUTCOME_MODEL_VERSION=untrained

# ── Ingestion state (Steps 5, 36, 37) ─────────────────────────────────
INGESTION_STATUS_PATH=data/ingestion_status.json
CHECKPOINT_DIR=data/checkpoints

# ── OKF knowledge bundle (Phase 3) ────────────────────────────────────
# Portable Open Knowledge Format v0.2 bundle, generated from the corpus by
# scripts/build_okf_bundle.py and validated by scripts/validate_okf.py.
# Leave blank to use the default (backend/knowledge); set an ABSOLUTE path only.
# OKF_BUNDLE_DIR=
OKF_VERSION=0.2

# ── Model / pipeline versioning (Step 41) ─────────────────────────────
INDEX_VERSION=1
RETRIEVER_VERSION=hybrid-v1
RERANKER_VERSION=bm25+ce-v1
PROMPT_VERSION=vidhiveda-rag-v1
