# ──────────────────────────────────────────────────────────────────────
# VIDHIVEDA — Environment Configuration Example
# ──────────────────────────────────────────────────────────────────────

# ── Frontend (Vite) ──────────────────────────────────────────────────
# Target FastAPI backend origin. Leave empty in production if using Vercel reverse proxy (/api).
VITE_API_BASE=https://vidhiveda-backend.onrender.com

# ── Backend Server ───────────────────────────────────────────────────
PORT=8000
API_HOST=0.0.0.0
CORS_ORIGINS=https://frontend-akon2005s-projects.vercel.app,http://localhost:5173

# ── Vector Store & Retrieval (Committed ChromaDB) ────────────────────
# The production container carries the committed 9,375-chunk corpus at /app/chroma_db.
VECTOR_STORE_DIR=/app/chroma_db
CASE_LAW_COLLECTION=vidhiveda_legal_cases
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
TOP_K=8

# ── LLM Generation (Optional / Configured in Render Dashboard) ──────
# Options: "huggingface" | "openai" | "anthropic"
LLM_PROVIDER=huggingface

# Hugging Face Inference
HF_API_TOKEN=
HF_MODEL=meta-llama/Llama-3.1-8B-Instruct

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
