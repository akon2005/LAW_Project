# --- Frontend ---
VITE_API_URL=/api

# --- Backend / LLM ---
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20240620
HF_API_TOKEN=
HF_MODEL=meta-llama/Llama-3.1-8B-Instruct

# --- Embedding / Vector Store (Production) ---
REMOTE_EMBEDDING_PROVIDER=openai
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# In production, ChromaDB is not installed, so no need for CHROMA variables.
